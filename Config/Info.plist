<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 后台播放。没有这条，锁屏 / 切到别的 App 时音频会被挂起。
	     其余键（CFBundleDisplayName、场景清单、屏幕方向等）仍由
	     GENERATE_INFOPLIST_FILE 自动生成，这里只补自动生成覆盖不到的项。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 允许访问本机的网易云 API 服务（模拟器里的 localhost）。
	     只开「本地网络」这一项，不开 ArbitraryLoads —— 公网仍然强制 HTTPS。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 实时活动（锁屏卡片 + 灵动岛）。没有这条，Activity.request 会直接失败。 -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
</dict>
</plist>
